# ---------------------------------------------------------------------------
# IA Weekly Meeting Hub – environment configuration
# Copy to .env (development) or inject via the approved secret manager (production).
# Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection (use TLS in production: append &sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/iahub?schema=public"

# Public base URL of the application (used for SSO redirect URIs). HTTPS in production.
APP_URL="https://iahub.example.internal"

# --- Enterprise SSO (OpenID Connect) — REQUIRED in production -------------
# Register a confidential web client with redirect URI: ${APP_URL}/api/auth/oidc/callback
OIDC_ISSUER_URL="https://login.microsoftonline.com/<tenant-id>/v2.0"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""                 # from the secret manager
OIDC_SCOPES="openid email profile"
OIDC_DISPLAY_NAME="Company Single Sign-On"
# Require an MFA method in the ID token's "amr" claim (default true).
OIDC_REQUIRE_MFA="true"
OIDC_MFA_AMR_VALUES="mfa,otp,hwk,swk,fido,phr,phrh"

# --- Sessions ---------------------------------------------------------------
SESSION_IDLE_MINUTES="60"
SESSION_ABSOLUTE_HOURS="10"

# --- Uploads ----------------------------------------------------------------
IMPORT_MAX_UPLOAD_BYTES="10485760"

# --- Bootstrap: first administrator (signs in via SSO; no password stored) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="System Administrator"

# --- Development only (ignored when NODE_ENV=production) ---------------------
AUTH_LOCAL_ENABLED="false"
SEED_DEV_PASSWORD=""
